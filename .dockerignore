# Ignora a pasta de ambiente virtual
venv/

# Ignora arquivos de configuração de ambiente
.env

# Ignora caches do Python
__pycache__/
**/__pycache__/
*.pyc

# Outros comuns
.git/
.gitignore
*.log
*.tmp
*.swp

